# Base URL used inside the activation link (no trailing slash).
APP_BASE_URL=http://localhost:3000

# --- Mail ---
# Development default: MailHog (docker compose up -d mailhog), UI at http://localhost:8025
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false

# Production (SMTP Unpad / Mailgun / etc.) — fill these on the server only.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

MAIL_FROM=E-KEP Unpad <no-reply@kep.unpad.ac.id>

# --- Database (SQL Server, legacy komitik_backup) ---
DB_HOST=localhost
DB_PORT=1433
DB_NAME=komitik_backup
DB_USER=sa
DB_PASSWORD=
# Named instance (e.g. SQLEXPRESS). Leave empty when using DB_PORT above.
DB_INSTANCE=
# Local/self-signed server: keep false/true. Set DB_ENCRYPT=true for a TLS-only server.
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true
